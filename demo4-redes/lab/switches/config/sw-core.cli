set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 192.168.11.0/31
set / network-instance default interface ethernet-1/1.0
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 192.168.11.2/31
set / network-instance default interface ethernet-1/2.0
set / system name host-name sw-core
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.0.255.1/32
set / network-instance default interface system0.0
set / network-instance default protocols bgp autonomous-system 65100
set / network-instance default protocols bgp router-id 10.0.255.1
set / network-instance default protocols bgp ebgp-default-policy import-reject-all false
set / network-instance default protocols bgp ebgp-default-policy export-reject-all false
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group underlay admin-state enable
set / network-instance default protocols bgp neighbor 192.168.11.1 peer-group underlay
set / network-instance default protocols bgp neighbor 192.168.11.1 peer-as 65101
set / network-instance default protocols bgp neighbor 192.168.11.3 peer-group underlay
set / network-instance default protocols bgp neighbor 192.168.11.3 peer-as 65102
