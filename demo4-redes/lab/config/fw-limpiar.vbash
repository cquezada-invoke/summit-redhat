#!/bin/vbash
# Vuelve el firewall a su base: borra las reglas 100-199 y los grupos creados por "Red · Solicitar acceso",
# y las reglas 200-299, grupos ocp-* e interfaces dummy creados por "Red · Preparar red OpenShift".
source /opt/vyatta/etc/functions/script-template
configure
for r in $(cli-shell-api listNodes firewall ipv4 forward filter rule | tr -d "'"); do
  if [ "$r" -ge 100 ] && [ "$r" -le 299 ]; then delete firewall ipv4 forward filter rule $r; fi
done
for g in $(cli-shell-api listNodes firewall group network-group | tr -d "'"); do
  case $g in acc-*|ocp-*) delete firewall group network-group $g ;; esac
done
for g in $(cli-shell-api listNodes firewall group port-group | tr -d "'"); do
  case $g in tcp-*|ocp-*) delete firewall group port-group $g ;; esac
done
for d in $(cli-shell-api listNodes interfaces dummy | tr -d "'"); do
  delete interfaces dummy $d
done
commit
save
exit
