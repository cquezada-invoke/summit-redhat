<?xml version="1.0" encoding="UTF-8"?>
<weblogic-web-app xmlns="http://xmlns.oracle.com/weblogic/weblogic-web-app">
  <context-root>/ventas</context-root>
  <resource-description>
    <res-ref-name>jdbc/VentasDS</res-ref-name>
    <jndi-name>jdbc/ventasDS</jndi-name>
  </resource-description>
  <resource-env-description>
    <resource-env-ref-name>jms/PedidosQueue</resource-env-ref-name>
    <jndi-name>jms/PedidosQueue</jndi-name>
  </resource-env-description>
  <session-descriptor>
    <timeout-secs>1800</timeout-secs>
  </session-descriptor>
  <container-descriptor>
    <prefer-web-inf-classes>true</prefer-web-inf-classes>
  </container-descriptor>
</weblogic-web-app>
