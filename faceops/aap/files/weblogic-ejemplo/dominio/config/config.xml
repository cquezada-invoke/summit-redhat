<?xml version="1.0" encoding="UTF-8"?>
<!-- Dominio WebLogic EMULADO para el laboratorio de FaceOps (sin producto Oracle instalado): solo los artefactos que se analizan -->
<domain xmlns="http://xmlns.oracle.com/weblogic/domain">
  <name>ventas_domain</name>
  <domain-version>14.1.1.0.0</domain-version>
  <server>
    <name>AdminServer</name>
    <listen-port>7001</listen-port>
  </server>
  <server>
    <name>ventas_ms1</name>
    <listen-port>8001</listen-port>
    <cluster>ventas_cluster</cluster>
  </server>
  <cluster>
    <name>ventas_cluster</name>
  </cluster>
  <app-deployment>
    <name>ventas</name>
    <target>ventas_cluster</target>
    <module-type>ear</module-type>
    <source-path>/u01/apps/ventas/ventas.ear</source-path>
    <security-dd-model>DDOnly</security-dd-model>
    <staging-mode>stage</staging-mode>
  </app-deployment>
  <app-deployment>
    <name>legado</name>
    <target>AdminServer</target>
    <module-type>war</module-type>
    <source-path>/u01/apps/legado/legado.war</source-path>
  </app-deployment>
  <jms-server>
    <name>VentasJMSServer</name>
    <target>ventas_ms1</target>
  </jms-server>
  <jms-system-resource>
    <name>PedidosModule</name>
    <target>ventas_cluster</target>
    <sub-deployment>
      <name>PedidosSub</name>
      <target>VentasJMSServer</target>
    </sub-deployment>
    <descriptor-file-name>jms/pedidosmodule-jms.xml</descriptor-file-name>
  </jms-system-resource>
  <jdbc-system-resource>
    <name>ventasDS</name>
    <target>ventas_cluster</target>
    <descriptor-file-name>jdbc/ventasDS-jdbc.xml</descriptor-file-name>
  </jdbc-system-resource>
</domain>
