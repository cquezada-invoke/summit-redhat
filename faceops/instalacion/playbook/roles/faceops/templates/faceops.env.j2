# {{ ansible_managed }} · contiene secretos (0600)
FACEOPS_BD={{ faceops_datos_dir }}/faceops.db
FACEOPS_PREFIJO={{ faceops_prefijo }}
FACEOPS_URL_PUBLICA={{ faceops_url_publica }}
FACEOPS_ADMIN={{ faceops_admin_usuario }}
FACEOPS_ADMIN_NOMBRE={{ faceops_admin_nombre }}
FACEOPS_VIGIA={{ '1' if faceops_vigia | bool else '0' }}
FACEOPS_AAP_URL={{ faceops_aap_url }}
FACEOPS_AAP_PUBLICA={{ faceops_aap_publica }}
FACEOPS_AAP_TOKEN={{ faceops_secretos['aap-token'] | default(faceops_aap_token) }}
{% if faceops_secretos['gitea-token'] is defined %}
FACEOPS_GITEA_TOKEN={{ faceops_secretos['gitea-token'] }}
{% endif %}
{% if faceops_secretos['respaldo-token'] is defined %}
FACEOPS_RESPALDO_TOKEN={{ faceops_secretos['respaldo-token'] }}
{% endif %}
{% if faceops_secretos['vault-secret-id'] is defined %}
FACEOPS_VAULT_ADDR={{ faceops_vault_url }}
FACEOPS_VAULT_ROLE_ID={{ faceops_secretos['vault-role-id'] }}
FACEOPS_VAULT_SECRET_ID={{ faceops_secretos['vault-secret-id'] }}
{% endif %}
{% if faceops_instalar_kb | bool %}
FACEOPS_KB_DSN={{ faceops_kb_dsn }}
{% endif %}
{% if faceops_secretos['guac-clave'] is defined %}
FACEOPS_GUAC_CLAVE={{ faceops_secretos['guac-clave'] }}
{% endif %}
FACEOPS_LLAVE_SSH={{ faceops_datos_dir }}/llaves/id_faceops
{% if faceops_smtp_host | length > 0 %}
FACEOPS_SMTP_HOST={{ faceops_smtp_host }}
FACEOPS_SMTP_PUERTO={{ faceops_smtp_puerto }}
FACEOPS_SMTP_USUARIO={{ faceops_smtp_usuario }}
FACEOPS_SMTP_CLAVE={{ faceops_smtp_clave }}
FACEOPS_SMTP_DE={{ faceops_smtp_de }}
{% endif %}
FACEOPS_VALIDADOR_URL={{ faceops_validador_url }}
FACEOPS_CONFIANZA_DIR={{ faceops_datos_dir }}/confianza
{% if faceops_ca_publica | length > 0 %}
FACEOPS_CA_PUBLICA={{ faceops_ca_publica }}
{% endif %}
REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
