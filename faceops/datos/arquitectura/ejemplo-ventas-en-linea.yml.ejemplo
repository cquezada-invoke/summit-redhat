# Ejemplo para «Solicitar nuevo segmento de negocio» (no se carga solo: termina en .ejemplo).
segmento: Ventas en línea
grupo: aplicaciones          # aplicaciones | redes | soluciones (grupo del menú principal)
codigo: ventas
version: 1
descripcion: "Tienda web: los clientes entran por el firewall perimetral y el WAF, un balanceador reparte entre dos servidores de aplicación JBoss y estos usan una base PostgreSQL"
responsable: Arquitectura Invoke
centro_de_datos: Centro de datos Santiago
ambientes: [produccion, qa]

ficha:
  area_negocio: Comercial · Venta digital
  dueno: Gerencia de Comercio Electrónico
  responsable_tecnico: Jefatura de Desarrollo de Canales
  soporte: Managed Service Invoke (N2)
  criticidad: alta
  horario_servicio: 24x7
  ventana_mantencion: "Miércoles 01:00 a 03:00"
  rto: 2 horas
  rpo: 15 minutos
  datos: "Datos personales y de pago de clientes (PCI DSS)"
  usuarios: Clientes (Internet)

entrada:
  desde: clientes
  hacia: lb
  puerto: 443

externos:
  - {id: clientes, nombre: Clientes (Internet)}

componentes:
  # Servicios de red del camino (appliances): se asignan a equipos existentes o se provisionan aparte
  - id: fwperim
    nombre: Firewall perimetral
    tipo: firewall
    replicas: 1
    uso: compartido
    equipos: [fgt]
  - id: waf
    nombre: WAF (protección de aplicaciones web)
    tipo: waf
    replicas: 1
    uso: compartido
    equipos: [fgt]
  # Servidores (se crean con «Habilitar servidor» o Infraestructura los asigna a existentes)
  - id: lb
    nombre: Balanceador Nginx
    tipo: balanceador
    producto: nginx
    sistema: rhel9
    replicas: {produccion: 1, qa: 1}
    recursos: {cpu: 1, ram_gb: 2, disco_gb: 20}
  - id: app
    nombre: Tienda JBoss
    producto: jboss
    sistema: rhel9
    replicas: {produccion: 2, qa: 1}
    recursos: {cpu: 2, ram_gb: 4, disco_gb: 20}
  - id: bd
    nombre: PostgreSQL de ventas
    producto: postgres
    sistema: rhel9
    replicas: {produccion: 1}
    recursos: {cpu: 2, ram_gb: 4, disco_gb: 40}

flujos:
  - {desde: clientes, hacia: lb, puerto: 443, via: [fwperim, waf], motivo: "entrada: los clientes abren la tienda (pasa por firewall y WAF)"}
  - {desde: lb, hacia: app, puerto: 8080, motivo: "balanceo hacia los JBoss", latencia_max_ms: 5}
  - {desde: app, hacia: bd, puerto: 5432, motivo: "base de datos de ventas", latencia_max_ms: 5}
