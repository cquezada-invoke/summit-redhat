# FaceAdmin · consola global (UBI 9 + Python 3.11)
FROM registry.access.redhat.com/ubi9/python-311:latest
USER 0
RUN pip install --no-cache-dir "flask==3.1.*" "requests==2.32.*" "gunicorn==23.0.*"
COPY *.py *.json /opt/faceadmin/
COPY templates /opt/faceadmin/templates
COPY static /opt/faceadmin/static
RUN mkdir -p /var/lib/faceadmin && chown -R 1001:0 /var/lib/faceadmin && chmod -R g=u /var/lib/faceadmin
USER 1001
WORKDIR /opt/faceadmin
ENV FACEADMIN_BD=/var/lib/faceadmin/faceadmin.db PYTHONUNBUFFERED=1
EXPOSE 8843
CMD ["gunicorn", "--workers", "1", "--threads", "8", "--bind", "0.0.0.0:8843", "--access-logfile", "-", "app:app"]
