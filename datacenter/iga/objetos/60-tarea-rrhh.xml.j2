<?xml version="1.0" encoding="UTF-8"?>
<!-- Reconciliación de RRHH cada minuto: altas, cambios y bajas se propagan solos a AD, Directory Server e IdM. -->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      oid="{{ oid.tarea_rrhh }}">
    <name>RRHH · reconciliación cada minuto</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="c:UserType"/>
    <executionState>runnable</executionState>
    <schedule>
        <recurrence>recurring</recurrence>
        <interval>60</interval>
    </schedule>
    <activity>
        <work>
            <reconciliation>
                <resourceObjects>
                    <resourceRef oid="{{ oid.rrhh }}" type="c:ResourceType"/>
                    <kind>account</kind>
                    <intent>default</intent>
                </resourceObjects>
            </reconciliation>
        </work>
    </activity>
</task>
