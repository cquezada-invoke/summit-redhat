   "options": {
    "mode": "markdown",
    "content": "### Summit · Nube (GCP) — ServiceNow pide, Event-Driven Ansible decide, AAP crea y protege. Solo se toca lo etiquetado **demo=summit-cloud**; el resto del proyecto solo se lee."
   }
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Nube conectada",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(nube_conectada)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "No (falta credencial)"
        },
        "1": {
         "text": "Sí"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
