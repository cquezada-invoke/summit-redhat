    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "bargauge",
   "title": "Huérfanos por tipo",
   "datasource": {
    "type": "prometheus",
