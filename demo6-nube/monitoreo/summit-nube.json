  },
  {
   "id": 8,
   "type": "table",
   "title": "VMs en GCP (node_exporter)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"nube-vms\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true
    },
    {
     "refId": "B",
     "expr": "100 - avg by (nombre) (rate(node_cpu_seconds_total{job=\"nube-vms\",mode=\"idle\"}[2m])) * 100",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true
    },
    {
     "refId": "C",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"nube-vms\"} / node_memory_MemTotal_bytes{job=\"nube-vms\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 1
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "rol": true,
       "sistema": true,
       "nube": true
      },
      "renameByName": {
       "Value #A": "Arriba",
       "Value #B": "CPU %",
       "Value #C": "Memoria %",
       "nombre": "VM",
       "instance": "Dirección"
      }
     }
    }
   ]
  }
 ]
