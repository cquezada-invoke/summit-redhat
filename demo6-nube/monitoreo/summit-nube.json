  {
   "id": 6,
   "type": "timeseries",
   "title": "VMs y reglas corregidas en el tiempo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(nube_vms_activas)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "VMs activas"
    },
    {
     "refId": "B",
     "expr": "max(nube_firewall_corregidas_total)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "Reglas restringidas (acumulado)"
    },
    {
     "refId": "C",
     "expr": "sum(nube_firewall_peligrosas)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "Reglas peligrosas ahora"
    }
   ],
